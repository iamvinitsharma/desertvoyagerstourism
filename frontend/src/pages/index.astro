<script>
  import { replay, initReveal } from '../lib/motion';

  // Hero slider
  const slides = document.querySelectorAll<HTMLElement>('.hero-slide');
  const copies = document.querySelectorAll<HTMLElement>('.hero-copy');
  const dots = document.querySelectorAll<HTMLElement>('.hero-dot');
  let cur = 0, timer: number;
  const show = (i: number) => {
    cur = (i + slides.length) % slides.length;
    slides.forEach((s, k) => { s.classList.toggle('opacity-100', k === cur); s.classList.toggle('opacity-0', k !== cur); });
    copies.forEach((c, k) => c.classList.toggle('hidden', k !== cur));
    replay(copies[cur], true);
    dots.forEach((d, k) => {
      d.classList.toggle('w-8', k === cur); d.classList.toggle('bg-brand-sand', k === cur);
      d.classList.toggle('w-4', k !== cur); d.classList.toggle('bg-white/50', k !== cur);
    });
  };
  const start = () => { clearInterval(timer); timer = window.setInterval(() => show(cur + 1), 6500); };
  dots.forEach((d, k) => d.addEventListener('click', () => { show(k); start(); }));
  document.querySelector('[data-prev]')?.addEventListener('click', () => { show(cur - 1); start(); });
  document.querySelector('[data-next]')?.addEventListener('click', () => { show(cur + 1); start(); });
  // Don't change slides while the visitor is using the search bar
  const search = document.getElementById('dv-search');
  search?.addEventListener('focusin', () => clearInterval(timer));
  search?.addEventListener('focusout', () => start());
  start();

  // ---- Category tiles → show that category's slider directly below.
  // Clicking the selected tile again (or "Back to featured") returns to Featured.
  const tiles = document.querySelectorAll<HTMLButtonElement>('.cat-tile');
  const panelsEl = document.querySelectorAll<HTMLElement>('[data-panel]');
  const results = document.getElementById('cat-results')!;
  let current = 'featured';
  const selectCat = (slug: string, scroll: boolean) => {
    current = slug;
    tiles.forEach(t => {
      const on = t.dataset.cat === slug;
      t.classList.toggle('is-active', on); t.setAttribute('aria-pressed', String(on));
    });
    panelsEl.forEach(p => {
      const on = p.dataset.panel === slug;
      p.classList.toggle('hidden', !on);
      if (on) {
        (p.querySelector('[data-carousel]') as any)?.refresh?.();
        replay(p.firstElementChild);
        replay(p.querySelector('[data-track]'), true);
      }
    });
    if (scroll && results.getBoundingClientRect().top > innerHeight * 0.55) results.scrollIntoView({ behavior: 'smooth' });
  };
  tiles.forEach(t => t.addEventListener('click', () => {
    const slug = t.dataset.cat!;
    selectCat(current === slug ? 'featured' : slug, current !== slug);
  }));
  document.querySelectorAll('[data-back-featured]').forEach(b => b.addEventListener('click', () => selectCat('featured', false)));

  // ---- "View all categories" (only shown when tiles don't all fit)
  const catCar = document.getElementById('cat-carousel')!;
  const catTrack = catCar.querySelector<HTMLElement>('[data-track]')!;
  const expand = document.getElementById('cat-expand')!;
  const syncExpand = () => {
    const overflow = catTrack.scrollWidth > catTrack.clientWidth + 2;
    const open = catCar.hasAttribute('data-expanded');
    expand.classList.toggle('hidden', !overflow && !open); expand.classList.toggle('inline-flex', overflow || open);
  };
  expand.addEventListener('click', () => {
    const open = catCar.toggleAttribute('data-expanded');
    expand.setAttribute('aria-expanded', String(open));
    expand.querySelector('[data-label]')!.textContent = open ? 'Show less' : `View all ${tiles.length} categories`;
    expand.querySelector('svg')!.style.transform = open ? 'rotate(180deg)' : '';
    syncExpand();
  });
  new ResizeObserver(syncExpand).observe(catTrack);
  addEventListener('resize', syncExpand);
  addEventListener('load', syncExpand);
  syncExpand();

  // ---- Welcome section tabs
  const wtabs = document.querySelectorAll<HTMLButtonElement>('.welcome-tab');
  wtabs.forEach(t => t.addEventListener('click', () => {
    wtabs.forEach(x => {
      const on = x === t;
      x.setAttribute('aria-selected', String(on));
      x.classList.toggle('border-brand-sand', on); x.classList.toggle('text-brand-sand-dark', on);
      x.classList.toggle('border-transparent', !on); x.classList.toggle('text-ink', !on);
      const dot = x.querySelector('span')!;
      dot.classList.toggle('bg-brand-sand', on); dot.classList.toggle('text-white', on);
      dot.classList.toggle('bg-white', !on); dot.classList.toggle('text-ink-soft', !on);
    });
    document.querySelectorAll<HTMLElement>('[data-wpanel]').forEach(p => {
      const on = p.dataset.wpanel === t.dataset.wtab;
      p.classList.toggle('hidden', !on);
      if (on) replay(p);
    });
  }));

  // ---- Things-to-do explorer tabs
  const xtabs = document.querySelectorAll<HTMLButtonElement>('.x-tile');
  xtabs.forEach(t => t.addEventListener('click', () => {
    xtabs.forEach(x => {
      const on = x === t;
      const bg = (x.dataset.activeBg || '').split(' ');
      x.setAttribute('aria-selected', String(on));
      bg.forEach(c => c && x.classList.toggle(c, on));
      ['text-white', 'shadow-xl'].forEach(c => x.classList.toggle(c, on));
      ['bg-sand-50', 'text-ink', 'hover:-translate-y-1', 'hover:bg-sand-100'].forEach(c => x.classList.toggle(c, !on));
      x.querySelector('.x-icon')?.classList.toggle('!text-white', on);
    });
    document.querySelectorAll<HTMLElement>('[data-xpanel]').forEach(p => {
      const on = p.dataset.xpanel === t.dataset.xtab;
      p.classList.toggle('hidden', !on);
      if (on) { replay(p.firstElementChild); replay(p.lastElementChild, true); replay(p.querySelector('ul'), true); }
    });
  }));

  // ---- Gentle reveal for sections below the banner
  document.querySelectorAll('main > section:nth-of-type(n+3) > .container-x').forEach(el => el.setAttribute('data-reveal', ''));
  initReveal();
</script>

