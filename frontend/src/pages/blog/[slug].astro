---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import TourCard from '../../components/TourCard.astro';
import { posts, formatDate } from '../../data/blog';
import { tours } from '../../data/tours';
import { site } from '../../data/site';

// Used only by the static GitHub Pages preview build (ignored when server-rendered).
export function getStaticPaths() {
  return posts.map(p => ({ params: { slug: p.slug } }));
}

const post = posts.find(p => p.slug === Astro.params.slug);
if (!post) return Astro.rewrite('/404');
const related = post.related
  .map(h => tours.find(t => h.endsWith('/' + t.slug)))
  .filter(Boolean) as typeof tours;
const more = posts.filter(p => p.slug !== post.slug).slice(0, 3);
---
<Layout title={`${post.title} | Desert Voyagers Tourism`} description={post.excerpt}>
  <article>
    <header class="relative isolate overflow-hidden bg-ink">
      <img src={post.image} alt="" class="absolute inset-0 -z-10 size-full object-cover opacity-50" />
      <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink via-ink/60 to-ink/20"></div>
      <div class="container-x max-w-4xl py-16 sm:py-24">
        <nav class="flex items-center gap-1.5 text-sm text-white/70" aria-label="Breadcrumb">
          <a href="/" class="hover:text-white">Home</a><Icon name="chevron-right" size={14} /><a href="/blog" class="hover:text-white">Blog</a>
        </nav>
        <span class="mt-5 inline-block rounded-full bg-brand-sand px-3 py-1 text-xs font-bold uppercase tracking-wide text-white">{post.category}</span>
        <h1 class="mt-4 text-balance text-3xl font-semibold leading-tight text-white sm:text-5xl">{post.title}</h1>
        <p class="mt-4 flex flex-wrap items-center gap-4 text-sm text-white/75">
          <span>By the Desert Voyagers team</span>
          <span class="flex items-center gap-1.5"><Icon name="calendar" size={14} />{formatDate(post.date)}</span>
          <span class="flex items-center gap-1.5"><Icon name="clock" size={14} />{post.readTime}</span>
        </p>
      </div>
    </header>

    <div class="container-x grid max-w-6xl gap-10 py-12 lg:grid-cols-[minmax(0,1fr)_320px]">
      <div class="max-w-none">
        <p class="text-xl leading-relaxed text-ink">{post.excerpt}</p>
        {post.body.map(b => (
          <section class="mt-8">
            {b.h && <h2 class="font-display text-2xl font-semibold text-ink">{b.h}</h2>}
            {b.p.map(t => <p class="mt-3 text-[17px] leading-[1.8] text-ink-soft">{t}</p>)}
          </section>
        ))}
        <div class="mt-10 flex flex-col items-start justify-between gap-4 rounded-2xl bg-sand-50 p-6 sm:flex-row sm:items-center">
          <div><p class="font-display text-lg font-semibold">Planning your trip?</p><p class="text-sm text-ink-soft">Ask our local team anything on WhatsApp.</p></div>
          <a href={site.whatsapp} target="_blank" rel="noopener" class="btn bg-[#25D366] !px-5 !py-3 text-white"><Icon name="whatsapp" size={18} />Chat with us</a>
        </div>
      </div>

      <aside class="space-y-5">
        {related.length > 0 && <p class="font-display text-lg font-semibold">Book the experience</p>}
        {related.map(t => <TourCard tour={t} />)}
      </aside>
    </div>

    <section class="bg-sand-50/60 py-12">
      <div class="container-x">
        <h2 class="section-title !text-2xl">More from the blog</h2>
        <div class="mt-6 grid gap-6 sm:grid-cols-3">
          {more.map(p => (
            <a href={`/blog/${p.slug}`} class="group overflow-hidden rounded-3xl border border-line bg-white transition hover:shadow-xl hover:shadow-ink/5">
              <span class="block aspect-[16/10] overflow-hidden"><img src={p.image} alt="" loading="lazy" class="size-full object-cover transition duration-500 group-hover:scale-105" /></span>
              <span class="block p-5"><span class="text-xs font-bold uppercase tracking-wide text-brand-sand">{p.category}</span><span class="mt-1 block font-display font-semibold leading-snug group-hover:text-brand-blue">{p.title}</span></span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </article>
</Layout>
