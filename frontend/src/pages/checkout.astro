---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { ticketCatalog } from '../lib/catalog';
const catalog = ticketCatalog();
const field = 'w-full rounded-xl border border-line bg-white px-4 py-3 text-[15px] outline-none transition focus:border-brand-green focus:ring-4 focus:ring-green-100';
const steps = ['Cart', 'Your details', 'Payment', 'E-ticket'];
---
<Layout title="Checkout | Desert Voyagers Tourism">
  <section class="bg-sand-50/60 py-10 sm:py-14">
    <div class="container-x">
      <!-- progress -->
      <ol class="flex items-center gap-2 text-sm" aria-label="Checkout progress">
        {steps.map((s, i) => (
          <li class="flex items-center gap-2">
            <span class:list={['grid size-7 place-items-center rounded-full text-xs font-bold', i === 0 ? 'bg-brand-green text-white' : i === 1 ? 'bg-ink text-white' : 'bg-white text-ink-soft ring-1 ring-line']}>
              {i === 0 ? <Icon name="check" size={14} /> : i + 1}
            </span>
            <span class:list={['hidden sm:inline', i === 1 ? 'font-semibold text-ink' : 'text-ink-soft']}>{s}</span>
            {i < steps.length - 1 && <span class="h-px w-6 bg-line sm:w-10"></span>}
          </li>
        ))}
      </ol>

      <h1 class="mt-6 text-3xl font-semibold sm:text-4xl">Checkout</h1>

      <div id="co-empty" class="mt-8 hidden rounded-3xl border border-dashed border-sand-200 bg-white p-12 text-center">
        <p class="font-display text-xl font-semibold">Your cart is empty</p>
        <a href="/tickets" class="btn-primary mt-4 !px-6 !py-3">Browse tickets</a>
      </div>

      <form id="co-form" class="mt-8 hidden gap-8 lg:grid-cols-[minmax(0,1fr)_400px]" novalidate>
        <div class="space-y-6">
          <div class="rounded-3xl border border-line bg-white p-6 sm:p-7">
            <h2 class="font-display text-lg font-semibold">Lead guest details</h2>
            <p class="mt-1 text-sm text-ink-soft">E-tickets are sent to this email and WhatsApp number.</p>
            <div class="mt-5 grid gap-4 sm:grid-cols-2">
              <label class="block"><span class="mb-1.5 block text-sm font-semibold">First name *</span><input name="firstName" required autocomplete="given-name" class={field} /></label>
              <label class="block"><span class="mb-1.5 block text-sm font-semibold">Last name *</span><input name="lastName" required autocomplete="family-name" class={field} /></label>
              <label class="block"><span class="mb-1.5 block text-sm font-semibold">Email *</span><input name="email" type="email" required autocomplete="email" class={field} /></label>
              <label class="block"><span class="mb-1.5 block text-sm font-semibold">Mobile / WhatsApp *</span>
                <div class="flex gap-2">
                  <select name="dial" class={`${field} !w-28 shrink-0`} aria-label="Country code">
                    {['+971', '+966', '+968', '+974', '+973', '+965', '+91', '+92', '+44', '+1', '+49', '+7', '+86', '+63'].map(c => <option>{c}</option>)}
                  </select>
                  <input name="phone" type="tel" required autocomplete="tel-national" placeholder="50 123 4567" class={field} />
                </div>
              </label>
            </div>
            <label class="mt-4 block"><span class="mb-1.5 block text-sm font-semibold">Notes (optional)</span><textarea name="notes" rows="2" class={`${field} resize-none`}></textarea></label>
          </div>

          <div class="rounded-3xl border border-line bg-white p-6 sm:p-7">
            <h2 class="font-display text-lg font-semibold">Payment</h2>
            <div class="mt-4 flex items-center gap-4 rounded-2xl border-2 border-brand-green bg-green-50/40 p-4">
              <span class="grid size-11 place-items-center rounded-xl bg-white text-brand-green shadow-sm"><Icon name="card" size={22} /></span>
              <div class="flex-1"><p class="font-semibold">Credit / debit card</p><p class="text-sm text-ink-soft">You’ll enter card details on the bank’s secure payment page.</p></div>
              <div class="hidden gap-1 sm:flex">{['VISA', 'Mastercard'].map(p => <span class="rounded-md border border-line bg-white px-2 py-1 text-[11px] font-bold">{p}</span>)}</div>
            </div>
            <p class="mt-3 flex items-start gap-2 rounded-xl bg-amber-50 p-3 text-sm text-amber-800">
              <Icon name="shield" size={16} class="mt-0.5 shrink-0" />
              <span><b>Test mode:</b> online payment (Network International N-Genius) will be connected with the backend. Orders placed now are saved as demo orders and no card is charged.</span>
            </p>
            <label class="mt-5 flex items-start gap-3 text-sm">
              <input type="checkbox" name="terms" required class="mt-0.5 size-4 accent-[#3c9a4a]" />
              <span>I agree to the <a href="/terms" class="font-semibold text-brand-blue hover:underline">terms & conditions</a> and the <a href="/cancellation-policy" class="font-semibold text-brand-blue hover:underline">ticket cancellation policy</a>.</span>
            </label>
          </div>
        </div>

        <aside>
          <div class="rounded-3xl border border-line bg-white p-6 shadow-xl shadow-ink/5 lg:sticky lg:top-28">
            <div class="flex items-center justify-between"><h2 class="font-display text-lg font-semibold">Your order</h2><a href="/cart" class="text-sm font-semibold text-brand-blue hover:underline">Edit</a></div>
            <ul id="co-items" class="mt-4 divide-y divide-line"></ul>
            <div class="mt-2 flex items-center justify-between border-t border-line pt-4">
              <span class="font-semibold">Total to pay</span><span id="co-total" class="font-display text-2xl font-bold">AED 0</span>
            </div>
            <p data-error class="mt-4 hidden rounded-lg bg-red-50 px-3 py-2 text-sm text-red-600" role="alert"></p>
            <button type="submit" class="btn mt-5 w-full bg-brand-green !py-4 !text-base text-white hover:bg-[#2f7f3b] disabled:opacity-60">
              <Icon name="shield" size={18} /><span data-pay>Pay securely</span>
            </button>
            <p class="mt-3 text-center text-xs text-ink-soft">256-bit encrypted payment. E-tickets are sent instantly after payment.</p>
          </div>
        </aside>
      </form>
    </div>
  </section>
  <script type="application/json" id="catalog" set:html={JSON.stringify(catalog)} />
</Layout>

<script>
  import { getCart } from '../lib/cart';
  const C = JSON.parse(document.getElementById('catalog')!.textContent!);
  const aed = (n: number) => 'AED ' + n.toLocaleString('en-AE');
  const esc = (s: string) => s.replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
  const cart = getCart().filter(i => C[i.slug]);
  const form = document.getElementById('co-form') as HTMLFormElement;

  if (!cart.length) document.getElementById('co-empty')!.classList.remove('hidden');
  else {
    form.classList.remove('hidden'); form.classList.add('grid');
    let total = 0;
    document.getElementById('co-items')!.innerHTML = cart.map(i => {
      const c = C[i.slug], p = c.prices;
      const line = i.qty.adult * p.adult + i.qty.child * p.child + i.qty.infant * p.infant; total += line;
      const who = [i.qty.adult && `${i.qty.adult} adult`, i.qty.child && `${i.qty.child} child`, i.qty.infant && `${i.qty.infant} infant`].filter(Boolean).join(', ');
      const d = new Date(i.date + 'T00:00').toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
      return `<li class="flex gap-3 py-3">
        <span class="size-14 shrink-0 overflow-hidden rounded-lg bg-gradient-to-br from-brand-blue to-brand-blue-dark">${c.image ? `<img src="${c.image}" alt="" class="size-full object-cover">` : ''}</span>
        <div class="min-w-0 flex-1"><p class="line-clamp-2 text-sm font-semibold leading-snug">${esc(c.title)}</p><p class="text-xs text-ink-soft">${d}${i.time ? ' · ' + i.time : ''} · ${who}</p></div>
        <span class="whitespace-nowrap text-sm font-semibold">${aed(line)}</span></li>`;
    }).join('');
    document.getElementById('co-total')!.textContent = aed(total);
    form.querySelector('[data-pay]')!.textContent = `Pay ${aed(total)} securely`;

    const err = form.querySelector<HTMLElement>('[data-error]')!;
    form.addEventListener('submit', async e => {
      e.preventDefault(); err.classList.add('hidden');
      const bad = [...form.querySelectorAll<HTMLInputElement>('[required]')].find(i => i.type === 'checkbox' ? !i.checked : !i.value.trim() || !i.checkValidity());
      if (bad) {
        err.textContent = bad.type === 'checkbox' ? 'Please accept the terms to continue.' : 'Please complete all required fields correctly.';
        err.classList.remove('hidden'); bad.focus(); return;
      }
      const fd = new FormData(form);
      const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!; btn.disabled = true;
      const label = form.querySelector<HTMLElement>('[data-pay]')!; const old = label.textContent; label.textContent = 'Processing…';
      try {
        const res = await fetch('/api/checkout', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            items: cart.map(({ slug, date, time, qty }) => ({ slug, date, time, qty })),
            customer: { firstName: fd.get('firstName'), lastName: fd.get('lastName'), email: fd.get('email'), phone: `${fd.get('dial')} ${fd.get('phone')}`, notes: fd.get('notes') },
            terms: true,
          }),
        });
        const data = await res.json();
        if (!res.ok || !data.ok) throw new Error(data.error || 'Payment could not be started');
        location.href = data.paymentUrl;
      } catch (x: any) {
        err.textContent = x.message; err.classList.remove('hidden'); btn.disabled = false; label.textContent = old;
      }
    });
  }
</script>
