---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
Astro.response.status = 404;
---
<Layout title="Page not found | Desert Voyagers Tourism">
  <section class="container-x flex min-h-[60vh] flex-col items-center justify-center py-20 text-center">
    <span class="grid size-20 place-items-center rounded-full bg-sand-100 text-brand-sand"><Icon name="compass" size={36} /></span>
    <h1 class="mt-6 text-3xl font-semibold sm:text-4xl">Lost in the desert?</h1>
    <p class="mt-2 max-w-md text-ink-soft">We couldn’t find that page. It may have moved, or the tour is no longer available.</p>
    <div class="mt-6 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn-primary !px-6 !py-3">Back to home</a>
      <a href="/tours" class="btn-ghost !px-6 !py-3">Browse tours</a>
    </div>
  </section>
</Layout>
