---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { ticketCatalog } from '../lib/catalog';
const catalog = ticketCatalog();
---
<Layout title="Your cart | Desert Voyagers Tourism">
  <section class="bg-sand-50/60 py-10 sm:py-14">
    <div class="container-x">
      <h1 class="text-3xl font-semibold sm:text-4xl">Your cart</h1>
      <p class="mt-1 text-ink-soft">Attraction tickets are paid online and delivered instantly. Tours are booked by request on each tour page.</p>

      <div id="cart-empty" class="mt-8 hidden flex-col items-center gap-3 rounded-3xl border border-dashed border-sand-200 bg-white p-12 text-center">
        <span class="grid size-16 place-items-center rounded-full bg-sand-100 text-brand-sand"><Icon name="cart" size={28} /></span>
        <p class="font-display text-xl font-semibold">Your cart is empty</p>
        <p class="max-w-sm text-sm text-ink-soft">Add attraction tickets like Burj Khalifa or Louvre Abu Dhabi to get instant e-tickets.</p>
        <a href="/tickets" class="btn-primary mt-2 !px-6 !py-3">Browse tickets</a>
      </div>

      <div id="cart-full" class="mt-8 hidden gap-8 lg:grid-cols-[minmax(0,1fr)_360px]">
        <ul id="cart-list" class="space-y-4"></ul>
        <aside>
          <div class="rounded-3xl border border-line bg-white p-6 shadow-xl shadow-ink/5 lg:sticky lg:top-28">
            <h2 class="font-display text-lg font-semibold">Order summary</h2>
            <dl class="mt-4 space-y-2 text-sm">
              <div class="flex justify-between"><dt class="text-ink-soft">Tickets</dt><dd id="sum-count">0</dd></div>
              <div class="flex justify-between border-t border-line pt-3 text-base"><dt class="font-semibold">Total</dt><dd id="sum-total" class="font-display text-xl font-bold">AED 0</dd></div>
            </dl>
            <a href="/checkout" class="btn mt-5 w-full bg-brand-green !py-3.5 !text-base text-white hover:bg-[#2f7f3b]">Checkout securely <Icon name="arrow-right" size={18} /></a>
            <a href="/tickets" class="mt-3 block text-center text-sm font-semibold text-brand-blue hover:underline">Continue shopping</a>
            <ul class="mt-5 space-y-2 border-t border-line pt-4 text-xs text-ink-soft">
              <li class="flex items-center gap-2"><Icon name="zap" size={14} class="text-brand-green" />Instant e-tickets by email & WhatsApp</li>
              <li class="flex items-center gap-2"><Icon name="shield" size={14} class="text-brand-green" />Secure, encrypted card payment</li>
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </section>
  <script type="application/json" id="catalog" set:html={JSON.stringify(catalog)} />
</Layout>

<script>
  import { getCart, setCart, type CartItem } from '../lib/cart';
  const C = JSON.parse(document.getElementById('catalog')!.textContent!);
  const aed = (n: number) => 'AED ' + n.toLocaleString('en-AE');
  const esc = (s: string) => s.replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
  const fmtDate = (d: string) => new Date(d + 'T00:00').toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' });
  const labels: Record<string, string> = { adult: 'Adult', child: 'Child', infant: 'Infant' };
  const list = document.getElementById('cart-list')!;

  const lineTotal = (i: CartItem) => { const p = C[i.slug].prices; return i.qty.adult * p.adult + i.qty.child * p.child + i.qty.infant * p.infant; };

  const render = () => {
    const cart = getCart().filter(i => C[i.slug]);
    document.getElementById('cart-empty')!.classList.toggle('hidden', cart.length > 0);
    document.getElementById('cart-empty')!.classList.toggle('flex', cart.length === 0);
    document.getElementById('cart-full')!.classList.toggle('hidden', cart.length === 0);
    document.getElementById('cart-full')!.classList.toggle('grid', cart.length > 0);
    list.innerHTML = cart.map(i => {
      const c = C[i.slug];
      return `<li class="flex gap-4 rounded-2xl border border-line bg-white p-4" data-id="${i.id}">
        <a href="${c.href}" class="size-24 shrink-0 overflow-hidden rounded-xl bg-gradient-to-br from-brand-blue to-brand-blue-dark sm:size-28">${c.image ? `<img src="${c.image}" alt="" class="size-full object-cover">` : ''}</a>
        <div class="min-w-0 flex-1">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              <a href="${c.href}" class="font-display font-semibold leading-snug hover:text-brand-blue">${esc(c.title)}</a>
              <p class="mt-1 text-sm text-ink-soft">${fmtDate(i.date)}${i.time ? ' · ' + i.time : ''} · ${esc(c.location)}</p>
            </div>
            <button data-remove class="grid size-8 shrink-0 place-items-center rounded-full text-ink-soft hover:bg-red-50 hover:text-red-500" aria-label="Remove">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6"/></svg></button>
          </div>
          <div class="mt-3 flex flex-wrap items-end justify-between gap-3">
            <div class="flex flex-wrap gap-2">
              ${(['adult', 'child', 'infant'] as const).map(k => `
                <div class="flex items-center gap-2 rounded-full border border-line py-1 pl-3 pr-1 text-sm">
                  <span class="text-ink-soft">${labels[k]}</span>
                  <button data-dec="${k}" class="grid size-6 place-items-center rounded-full bg-sand-100 leading-none hover:bg-sand-200" aria-label="Fewer ${labels[k]}">−</button>
                  <span class="w-4 text-center font-semibold">${i.qty[k]}</span>
                  <button data-inc="${k}" class="grid size-6 place-items-center rounded-full bg-sand-100 leading-none hover:bg-sand-200" aria-label="More ${labels[k]}">+</button>
                </div>`).join('')}
            </div>
            <p class="font-display text-lg font-bold">${aed(lineTotal(i))}</p>
          </div>
        </div>
      </li>`;
    }).join('');
    document.getElementById('sum-count')!.textContent = String(cart.reduce((n, i) => n + i.qty.adult + i.qty.child + i.qty.infant, 0));
    document.getElementById('sum-total')!.textContent = aed(cart.reduce((n, i) => n + lineTotal(i), 0));
  };

  list.addEventListener('click', e => {
    const btn = (e.target as HTMLElement).closest('button'); if (!btn) return;
    const id = btn.closest('li')!.dataset.id;
    let cart = getCart();
    const item = cart.find(i => i.id === id); if (!item) return;
    if (btn.hasAttribute('data-remove')) cart = cart.filter(i => i.id !== id);
    else {
      const k = (btn.dataset.inc || btn.dataset.dec) as 'adult' | 'child' | 'infant';
      item.qty[k] = Math.max(0, Math.min(20, item.qty[k] + (btn.dataset.inc ? 1 : -1)));
      if (item.qty.adult + item.qty.child === 0) cart = cart.filter(i => i.id !== id);
    }
    setCart(cart); render();
  });
  render();
</script>
