---
// Tour booking REQUEST (no online payment). Posts to /api/enquiry; team confirms on WhatsApp.
import Icon from './Icon.astro';
import DatePicker from './DatePicker.astro';
import { type Tour, formatAED } from '../data/tours';
import type { Details } from '../data/details';
import { site } from '../data/site';
import type { LiveAvailability } from '../lib/availability';
interface Props { tour: Tour; details: Details; availability?: LiveAvailability | null }
const { tour, details: d, availability = null } = Astro.props;
const pricing = { prices: d.prices, addons: d.addons };
const field = 'w-full rounded-xl border border-line bg-white px-3.5 py-2.5 text-[15px] outline-none transition focus:border-brand-sand focus:ring-4 focus:ring-orange-100';
---
<div class="overflow-hidden rounded-3xl border border-line bg-white shadow-xl shadow-ink/5" id="enquiry-card" data-wa={site.whatsappNumber}>
  <div class="border-b border-line bg-gradient-to-br from-sand-50 to-white p-5">
    <p class="text-xs font-semibold uppercase tracking-wide text-ink-soft">From {tour.oldPrice && <s class="ml-1">{formatAED(tour.oldPrice)}</s>}</p>
    <p class="mt-0.5 flex items-baseline gap-2"><span class="font-display text-3xl font-bold text-ink">{formatAED(tour.price)}</span><span class="text-sm text-ink-soft">per adult</span></p>
    <p class="mt-2 flex items-center gap-1.5 text-sm font-medium text-brand-green"><Icon name="check" size={16} />No prepayment. Pay after we confirm.</p>
  </div>

  <form id="enquiry-form" class="space-y-4 p-5" novalidate>
    <input type="hidden" name="slug" value={tour.slug} />
    <!-- honeypot -->
    <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

    <DatePicker name="date" slug={tour.slug} label="Tour date" minOffsetDays={1} accent="sand" availability={availability} />

    <div>
      <span class="mb-1.5 block text-sm font-semibold">Guests</span>
      <div class="divide-y divide-line rounded-xl border border-line">
        {d.prices.map(p => (
          <div class="flex items-center justify-between gap-3 px-3.5 py-2.5">
            <div>
              <p class="text-[15px] font-semibold">{p.label} <span class="text-xs font-normal text-ink-soft">{p.sub}</span></p>
              <p class="text-xs text-ink-soft">{p.price ? formatAED(p.price) : 'Free'}</p>
            </div>
            <div class="flex items-center gap-2.5" data-qty={p.key}>
              <button type="button" data-dec class="grid size-8 place-items-center rounded-full border border-line text-lg leading-none hover:border-ink disabled:opacity-30" aria-label={`Fewer ${p.label}`}>−</button>
              <input type="text" inputmode="numeric" name={p.key} value={p.key === 'adult' ? 2 : 0} data-min={p.key === 'adult' ? 1 : 0} data-max="30" readonly class="w-8 bg-transparent text-center text-base font-semibold tabular-nums outline-none" aria-label={`${p.label} count`} />
              <button type="button" data-inc class="grid size-8 place-items-center rounded-full border border-line text-lg leading-none hover:border-ink" aria-label={`More ${p.label}`}>+</button>
            </div>
          </div>
        ))}
      </div>
    </div>

    {d.addons.length > 0 && (
      <div>
        <span class="mb-1.5 block text-sm font-semibold">Optional extras</span>
        <div class="space-y-2">
          {d.addons.map(a => (
            <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-line px-3.5 py-2.5 transition has-[:checked]:border-brand-sand has-[:checked]:bg-orange-50/50">
              <input type="checkbox" name="addons" value={a.key} class="size-4 accent-[#e8873a]" />
              <span class="min-w-0 flex-1"><span class="block text-sm font-semibold">{a.label}</span>{a.sub && <span class="block text-xs text-ink-soft">{a.sub}</span>}</span>
              <span class="whitespace-nowrap text-sm font-semibold">+{formatAED(a.price)}<span class="text-xs font-normal text-ink-soft">{a.per === 'person' ? '/pp' : ''}</span></span>
            </label>
          ))}
        </div>
      </div>
    )}

    <div class="grid gap-3">
      <span class="-mb-1 block text-sm font-semibold">Your details</span>
      <input name="name" required autocomplete="name" placeholder="Full name *" class={field} />
      <div class="grid grid-cols-2 gap-3">
        <input name="phone" type="tel" required autocomplete="tel" placeholder="WhatsApp no. *" class={field} />
        <input name="email" type="email" required autocomplete="email" placeholder="Email *" class={field} />
      </div>
      {tour.pickup && <input name="hotel" autocomplete="off" placeholder="Hotel / pickup location" class={field} />}
      <textarea name="notes" rows="2" placeholder="Special requests (optional)" class={`${field} resize-none`}></textarea>
    </div>

    <div class="rounded-xl bg-sand-50 p-3.5">
      <div class="flex items-center justify-between text-sm"><span class="text-ink-soft">Estimated total</span><span data-total class="font-display text-xl font-bold text-ink">AED 0</span></div>
      <p data-breakdown class="mt-0.5 text-xs text-ink-soft"></p>
    </div>

    <p data-error class="hidden rounded-lg bg-red-50 px-3 py-2 text-sm text-red-600" role="alert"></p>

    <button type="submit" class="btn-primary w-full !py-3.5 !text-base">
      <span data-btn-label>Send booking request</span>
      <Icon name="arrow-right" size={18} />
    </button>
    <p class="text-center text-xs text-ink-soft">We reply on WhatsApp to confirm availability, pickup time and payment.</p>
  </form>

  <!-- success state -->
  <div data-success class="hidden p-6 text-center">
    <span class="mx-auto grid size-16 place-items-center rounded-full bg-green-50 text-brand-green"><Icon name="check" size={32} /></span>
    <h3 class="mt-4 font-display text-xl font-semibold">Booking request sent!</h3>
    <p class="mt-1 text-sm text-ink-soft">Reference <b data-ref class="text-ink"></b></p>
    <p class="mt-3 text-sm text-ink-soft">Our team will confirm your tour on WhatsApp shortly. Want a faster reply? Send us your reference now:</p>
    <a data-wa href={site.whatsapp} target="_blank" rel="noopener" class="btn mt-4 w-full bg-[#25D366] !py-3 text-white"><Icon name="whatsapp" size={18} />Send on WhatsApp</a>
    <button type="button" data-again class="mt-3 text-sm font-semibold text-brand-blue hover:underline">Book another date</button>
  </div>
</div>

<script type="application/json" id="enquiry-pricing" set:html={JSON.stringify(pricing)} />

<script>
  import { STATIC_PREVIEW, demoRef, url } from '../lib/preview';
  const form = document.getElementById('enquiry-form') as HTMLFormElement | null;
  if (form) {
    const card = document.getElementById('enquiry-card')!;
    const P = JSON.parse(document.getElementById('enquiry-pricing')!.textContent!);
    const aed = (n: number) => 'AED ' + n.toLocaleString('en-AE');
    const num = (n: string) => +((form.elements.namedItem(n) as HTMLInputElement)?.value || 0);

    // date comes from the booking calendar (no preselected date; ?date= prefill handled there)
    const date = form.elements.namedItem('date') as HTMLInputElement;
    const picker = form.querySelector<HTMLElement>('[data-dp]');
    // carry over guests from homepage search (?adults=&children=)
    const qs = new URLSearchParams(location.search);

    const calc = () => {
      let total = 0; const parts: string[] = [];
      P.prices.forEach((p: any) => { const q = num(p.key); if (q) { total += q * p.price; parts.push(`${q} ${p.label.toLowerCase()}${q > 1 ? 's' : ''}`); } });
      const pax = num('adult') + num('child');
      form.querySelectorAll<HTMLInputElement>('input[name=addons]:checked').forEach(cb => {
        const a = P.addons.find((x: any) => x.key === cb.value); if (!a) return;
        total += a.per === 'person' ? a.price * pax : a.price; parts.push(a.label);
      });
      form.querySelector('[data-total]')!.textContent = aed(total);
      form.querySelector('[data-breakdown]')!.textContent = parts.join(' · ');
    };

    form.querySelectorAll<HTMLElement>('[data-qty]').forEach(s => {
      const input = s.querySelector('input')!; const min = +input.dataset.min!, max = +input.dataset.max!;
      const dec = s.querySelector<HTMLButtonElement>('[data-dec]')!;
      const set = (n: number) => { input.value = String(Math.max(min, Math.min(max, n))); dec.disabled = +input.value <= min; calc(); };
      dec.addEventListener('click', () => set(+input.value - 1));
      s.querySelector('[data-inc]')!.addEventListener('click', () => set(+input.value + 1));
      const pre = qs.get(input.name === 'adult' ? 'adults' : input.name === 'child' ? 'children' : '');
      set(pre ? +pre : +input.value);
    });
    form.addEventListener('change', calc);

    const err = form.querySelector<HTMLElement>('[data-error]')!;
    const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const label = form.querySelector<HTMLElement>('[data-btn-label]')!;

    form.addEventListener('submit', async e => {
      e.preventDefault(); err.classList.add('hidden');
      if (!date.value) { err.textContent = 'Please choose your tour date.'; err.classList.remove('hidden'); (picker as any)?.openPicker?.(); return; }
      const missing = [...form.querySelectorAll<HTMLInputElement>('input[required]:not([type=hidden])')].find(i => !i.value.trim() || !i.checkValidity());
      if (missing) { err.textContent = 'Please fill in ' + (missing.placeholder?.replace(' *', '') || 'all required fields') + ' correctly.'; err.classList.remove('hidden'); missing.focus(); return; }
      const fd = new FormData(form);
      const body: Record<string, any> = Object.fromEntries(fd.entries());
      body.addons = fd.getAll('addons');
      btn.disabled = true; label.textContent = 'Sending…';
      try {
        let data: any;
        if (STATIC_PREVIEW) {
          // GitHub Pages preview: no server, simulate a successful request
          await new Promise(r => setTimeout(r, 600));
          data = { ok: true, ref: demoRef('DV'), tour: document.querySelector('h1')?.textContent?.trim() };
        } else {
          const res = await fetch(url('/api/enquiry'), { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
          data = await res.json();
          if (!res.ok || !data.ok) throw new Error(data.error || 'Something went wrong');
        }
        form.classList.add('hidden');
        const ok = card.querySelector<HTMLElement>('[data-success]')!; ok.classList.remove('hidden');
        ok.querySelector('[data-ref]')!.textContent = data.ref;
        const msg = `Hi Desert Voyagers, I just sent a booking request.\nRef: ${data.ref}\nTour: ${data.tour}\nDate: ${body.date}\nGuests: ${body.adult} adults, ${body.child} children`;
        ok.querySelector<HTMLAnchorElement>('[data-wa]')!.href = `https://wa.me/${card.dataset.wa}?text=${encodeURIComponent(msg)}`;
        card.scrollIntoView({ behavior: 'smooth', block: 'start' });
      } catch (x: any) {
        err.textContent = x.message + '. Please try again or message us on WhatsApp.'; err.classList.remove('hidden');
      } finally { btn.disabled = false; label.textContent = 'Send booking request'; }
    });

    card.querySelector('[data-again]')!.addEventListener('click', () => {
      card.querySelector('[data-success]')!.classList.add('hidden'); form.classList.remove('hidden');
    });
    calc();
  }
</script>
