---
import Icon from './Icon.astro';
import AwardBadge from './AwardBadge.astro';
import { site, nav } from '../data/site';
// strip the deploy base (GitHub Pages preview) so active-link matching works everywhere
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '').replace(/\/$/, '') || '/';
---
<header id="site-header" class="sticky top-0 z-40 bg-white/95 backdrop-blur transition-shadow">
  <div class="container-x flex h-[84px] items-center justify-between gap-4 2xl:max-w-[1500px]">
    <a href="/" class="shrink-0" aria-label={site.name}>
      <img src="/images/logo.png" alt={site.name} width="220" height="91" class="h-14 w-auto sm:h-16" />
    </a>

    <nav class="hidden items-center gap-0.5 xl:flex" aria-label="Main">
      {nav.map(item => (
        <a href={item.href}
           class:list={['relative whitespace-nowrap rounded-full px-3 py-2 text-[13px] font-semibold uppercase tracking-wide transition hover:text-brand-sand',
             path === item.href ? 'text-brand-sand' : 'text-ink']}>
          {item.label}
          {path === item.href && <span class="absolute inset-x-3.5 -bottom-0.5 h-0.5 rounded-full bg-brand-sand"></span>}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-1 sm:gap-2">
      <a href={site.phoneHref} class="grid size-11 place-items-center rounded-full bg-sand-100 text-ink transition hover:bg-brand-sand hover:text-white" aria-label={`Call ${site.phone}`}>
        <Icon name="phone" size={19} />
      </a>
      <a href={site.whatsapp} target="_blank" rel="noopener" class="grid size-11 shrink-0 place-items-center rounded-full bg-[#25D366] text-white shadow-md shadow-green-700/30 transition hover:scale-105" aria-label="WhatsApp us">
        <Icon name="whatsapp" size={22} />
      </a>
      <!-- Tripadvisor award stacked above the WhatsApp number -->
      <div class="hidden flex-col items-start gap-1 pl-1 sm:flex">
        <AwardBadge variant="header" />
        <a href={site.whatsapp} target="_blank" rel="noopener" class="flex items-baseline gap-1.5 whitespace-nowrap leading-none hover:opacity-80">
          <span class="text-[11px] font-semibold uppercase tracking-wide text-ink-soft">WhatsApp</span>
          <span class="font-display text-[15px] font-bold text-brand-sand">{site.phone}</span>
        </a>
      </div>
      <a href="/cart" class="relative grid size-11 place-items-center rounded-full hover:bg-sand-100" aria-label="Cart">
        <Icon name="cart" size={22} />
        <span data-cart-count class="absolute right-0.5 top-0.5 hidden min-w-5 rounded-full bg-brand-sand px-1 text-center text-[11px] font-bold leading-5 text-white">0</span>
      </a>
      <button id="menu-btn" class="grid size-11 place-items-center rounded-full hover:bg-sand-100 xl:hidden" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
        <Icon name="menu" size={24} />
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden border-t border-line bg-white xl:hidden">
    <nav class="container-x flex flex-col py-3" aria-label="Mobile">
      {nav.map(item => <a href={item.href} class="rounded-lg px-3 py-3 font-medium hover:bg-sand-100">{item.label}</a>)}
      <div class="mt-2 grid grid-cols-2 gap-2 border-t border-line pt-3">
        <a href={site.phoneHref} class="btn-ghost"><Icon name="phone" size={16} />Call</a>
        <a href={site.whatsapp} class="btn bg-[#25D366] text-white"><Icon name="whatsapp" size={16} />WhatsApp</a>
      </div>
      <p class="mt-3 px-3 text-xs text-ink-soft">{site.hours} · {site.email}</p>
      <div class="mt-3 border-t border-line px-3 pt-3 sm:hidden"><AwardBadge variant="menu" /></div>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('site-header')!;
  const onScroll = () => header.classList.toggle('shadow-md', window.scrollY > 10);
  window.addEventListener('scroll', onScroll, { passive: true }); onScroll();

  const btn = document.getElementById('menu-btn')!;
  const menu = document.getElementById('mobile-menu')!;
  btn.addEventListener('click', () => {
    const open = menu.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
  });

  // Cart badge — number of tickets in the cart (updates live)
  import { cartCount } from '../lib/cart';
  const badge = document.querySelector<HTMLElement>('[data-cart-count]');
  const paintBadge = () => {
    if (!badge) return;
    const n = cartCount();
    badge.textContent = String(n); badge.classList.toggle('hidden', n === 0);
  };
  window.addEventListener('cart:change', paintBadge);
  window.addEventListener('storage', paintBadge);
  paintBadge();
</script>
