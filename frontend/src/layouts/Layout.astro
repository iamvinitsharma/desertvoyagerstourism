---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Preloader from '../components/Preloader.astro';
import { site } from '../data/site';

interface Props { title?: string; description?: string; intro?: boolean; bodyClass?: string }
const {
  title = `${site.name} | Desert Safari, City Tours & Attraction Tickets in the UAE`,
  description = 'Book desert safaris and Abu Dhabi & Dubai city tours with hotel pickup and no prepayment, and buy attraction tickets online with instant e-tickets.',
  intro = false,
  bodyClass = '',
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/images/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Lexend:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    {intro && (
      <script is:inline>
        // Show the desert intro once per visit; skip for reduced-motion users.
        // Add ?intro to the URL to replay it.
        try {
          if (location.search.indexOf('intro') > -1) document.documentElement.classList.add('intro-playing');
          else if (sessionStorage.getItem('dv_intro') || matchMedia('(prefers-reduced-motion: reduce)').matches)
            document.documentElement.classList.add('intro-seen');
          else document.documentElement.classList.add('intro-playing');
        } catch (e) { document.documentElement.classList.add('intro-seen'); }
      </script>
    )}
  </head>
  <body class={bodyClass}>
    {intro && <Preloader />}
    <Header />
    <main><slot /></main>
    <Footer />
  </body>
</html>
